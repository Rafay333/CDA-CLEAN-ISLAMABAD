PORT=4000
NODE_ENV=development
# Leave DATABASE_URL empty to use the built-in local database (no install).
# DATABASE_URL=postgres://cda:cda@localhost:5432/cda_clean
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
MEDIA_SECRET=change-me-media
PUBLIC_BASE_URL=http://localhost:4000
# Fixed OTP so the demo app can sign in. Unset this in production.
OTP_DEV_CODE=123456
UPLOAD_DIR=uploads
# Set to false when you run `npm run worker` as its own process.
RUN_WORKER=true
CORS_ORIGIN=*
# SQL Server database that holds Employees and Attendances.
# SMARTSWM_CONNECTION=Server=HOST;Database=SmartSWM;User Id=USER;Password=PASSWORD;TrustServerCertificate=True
# Optional. Defaults to AttendanceSystem/Server/models.
# FACE_MODELS=C:\path\to\AttendanceSystem\Server\models
